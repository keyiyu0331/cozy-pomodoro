<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Stop macOS "App Nap" from slowing the app down while its window is
       hidden. A timer has to stay on time in the background. -->
  <key>NSAppSleepDisabled</key>
  <true/>
</dict>
</plist>
